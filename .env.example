# -----------------------------------------------------------------------------
# Kontaktoplysninger
# Vises kun, når de er udfyldt. Uden dem falder footer og kontaktside tilbage til
# kontaktformularen i stedet for at vise tomme felter.
# -----------------------------------------------------------------------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_CVR=

# -----------------------------------------------------------------------------
# Booking
# Sæt til Google Calendar Appointment Schedule, Cal.com eller tilsvarende.
# Er den tom, sender alle "book et møde"-knapper til /kontakt, og /book-moede
# viderestiller dertil — så der aldrig opstår en blindgyde.
# Eksempel: https://calendar.google.com/calendar/appointments/schedules/...
# -----------------------------------------------------------------------------
VITE_BOOKING_URL=

# -----------------------------------------------------------------------------
# Sociale profiler (ikonerne vises kun, når en rigtig URL er sat)
# -----------------------------------------------------------------------------
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=

# -----------------------------------------------------------------------------
# Virksomhedens domæne (bruges til kanoniske URL'er, OG-tags og struktureret data)
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://www.aagesengrowth.dk
