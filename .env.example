# -----------------------------------------------------------------------------
# Kontaktoplysninger
# Kontakt@aagesengrowth.dk og CVR 46728068 er sat som standard i koden
# (src/config/company.ts), så begge kan stå tomme. Sæt dem kun, hvis andre
# værdier skal bruges. Intet telefonnummer vises på sitet, før der er et
# reelt at sætte her.
# -----------------------------------------------------------------------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_CVR=

# -----------------------------------------------------------------------------
# Booking — "Book en afklaring"
#
# Sæt til den offentlige booking-side for et 20-30 minutters møde. Er den
# tom, viser /book-en-afklaring en kort formular i stedet ("vi finder en tid
# sammen") — aldrig opdigtede ledige tider.
#
# Anbefaling: Cal.com. Gratis, synkroniserer to-vejs med Google Kalender, og
# kræver ingen server-integration — kun denne ene URL.
#   1. Opret en gratis konto på cal.com og forbind Google Kalender under
#      Apps → Google Calendar (OAuth i deres UI — intet, jeg gør her).
#   2. Opret et event type "Afklaring" (fx 20-30 min).
#   3. Kopiér den offentlige booking-URL, fx:
#      https://cal.com/marius-aagesen/afklaring
#   4. Sæt den her og som samme-navngivne env-variabel i Netlify.
# -----------------------------------------------------------------------------
VITE_BOOKING_URL=

# -----------------------------------------------------------------------------
# Sociale profiler (ikonerne vises kun, når en rigtig URL er sat)
# -----------------------------------------------------------------------------
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=

# -----------------------------------------------------------------------------
# Virksomhedens domæne (bruges til kanoniske URL'er, OG-tags og struktureret data)
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://aagesengrowth.com
